{
  "manifest_version": 3,
  "name": "ApplyOnce",
  "version": "1.0.0",
  "key": "",
  "description": "Your application profile, ready when you are.",
  "action": {
    "default_popup": "index.html",
    "default_title": "ApplyOnce"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
